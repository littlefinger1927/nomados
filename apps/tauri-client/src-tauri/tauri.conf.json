{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NomadOS",
  "version": "0.1.0",
  "identifier": "com.nomados.desktop",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../web-desktop/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NomadOS",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}