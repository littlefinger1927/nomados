# NomadOS secrets - generate with ./generate-secrets.sh
# Copy this file to .env and fill in values, or run generate-secrets.sh

SIGNING_SECRET=
MINIO_ROOT_PASSWORD=
MINIO_SECRET_KEY=
TURN_PASSWORD=
DATABASE_PASSWORD=

# WebAuthn configuration (required for production)
# RP_ID = the domain name (e.g., nomados.app)
# ORIGIN = the full HTTPS URL (e.g., https://nomados.app)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=https://localhost