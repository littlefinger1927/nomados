# NomadOS Caddyfile
# Serves the web-desktop frontend and proxies API requests to the gateway

localhost {
	# API routes go to the gRPC-gateway
	handle /v1/* {
		reverse_proxy gateway-service:8080
	}

	# Health check endpoint
	handle /health {
		reverse_proxy gateway-service:8080
	}

	# gRPC-Web and gRPC Gateway reflection
	handle /grpc.reflection.v1alpha.ServerReflection/* {
		reverse_proxy gateway-service:8080
	}

	# Everything else serves the Next.js frontend
	handle {
		reverse_proxy web-desktop:3000
	}

	# Add forwarded headers so the gateway knows the original scheme
	request_header X-Forwarded-For "{http.request.remote.host}"
	request_header X-Forwarded-Proto "https"
}

# Redirect HTTP to HTTPS
http://localhost {
	redir https://localhost{uri}
}